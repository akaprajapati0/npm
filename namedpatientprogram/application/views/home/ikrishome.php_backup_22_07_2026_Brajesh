    $(document).ready(function () {
      var track = document.getElementById('track');
      var controlBtn = document.getElementById('play-pause');

      function playAudio() {
        track.play();
        controlBtn.className = "pause";
        controlBtn.innerHTML = '<i class="ri-volume-up-line"> </i>';
      }

      function pauseAudio() {
        track.pause();
        controlBtn.className = "play";
        controlBtn.innerHTML = '<i class="ri-volume-mute-line"> </i>';
      }

      function togglePlayPause() {
        if (track.paused) {
          playAudio();
        } else {
          pauseAudio();
        }
      }
      // Play audio when the website opens
      playAudio();
      // Listen for user clicks to control audio playback
      controlBtn.addEventListener("click", togglePlayPause);
    });
  </script>

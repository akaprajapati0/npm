  <script>
    document.addEventListener("DOMContentLoaded", function () {

      let index = 0;
      const slides = document.querySelectorAll(".slider_1 .slide");

      function changeSlide() {
        slides.forEach(slide => slide.classList.remove("active"));
        slides[index].classList.add("active");
        index = (index + 1) % slides.length;
      }

      setInterval(changeSlide, 3500);

    });
    document.addEventListener("DOMContentLoaded", function () {

      const prescriptionModal = document.getElementById("prescriptionModal");
      const showPrescriptionBtn = document.getElementById("showPrescriptionForm");
      const closePrescriptionBtn = document.getElementById("closePrescriptionModal");

      if (!prescriptionModal || !showPrescriptionBtn || !closePrescriptionBtn) {
        return;
      }

      showPrescriptionBtn.addEventListener("click", function () {
        prescriptionModal.classList.add("active");
        document.body.style.overflow = "hidden";
      });

      closePrescriptionBtn.addEventListener("click", function () {
        prescriptionModal.classList.remove("active");
        document.body.style.overflow = "";
      });

      prescriptionModal.addEventListener("click", function (e) {
        if (e.target === prescriptionModal) {
          prescriptionModal.classList.remove("active");
          document.body.style.overflow = "";
        }
      });

      document.addEventListener("keydown", function (e) {
        if (
          e.key === "Escape" &&
          prescriptionModal.classList.contains("active")
        ) {
          prescriptionModal.classList.remove("active");
          document.body.style.overflow = "";
        }
      });

    });
  </script>

